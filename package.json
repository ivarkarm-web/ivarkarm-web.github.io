{
  "name": "ivar-karm-resonance",
  "private": true,
  "version": "1.0.0",
  "description": "Ivar Karm – Resonance: interactive handpan artist portfolio",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "test": "node scripts/smoke-test.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test:app": "node --test scripts/app-tests/*.test.mjs",
    "test:sw": "npx playwright test --project=sw-desktop",
    "test:a11y": "npx playwright test phase5-a11y",
    "check:app": "npm run check:handpan-cache && npm run test && npm run test:app && npx playwright test",
    "sync:handpan": "node scripts/sync-handpan-cache.mjs",
    "check:handpan-cache": "node scripts/sync-handpan-cache.mjs --check"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@playwright/test": "^1.56.1"
  }
}
